# --- 1) IA para ranking viral, roteiro 3 atos e Hook Titles ---
# OpenRouter Free Router (prioridade automatica usando modelos :free):
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# HuggingFace Token (modelos free / download GGUF):
# HF_TOKEN=
# Para usar llama-server offline no celular (scripts/start_local_llm.sh):
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=qwen2.5-1.5b-instruct
# AUTO_PILOT_ENABLED=1
# Limite inteligente de retencao de armazenamento no celular:
# STORAGE_MAX_VIDEOS=20
# STORAGE_MAX_MB=1200

# --- 2) Publicacao Automatica (escolha 1 dos caminhos) ---
# Caminho A: Webhook para n8n / Postiz / Upload-Post
# PUBLISH_WEBHOOK_URL=

# Caminho B: Instagram Graph API v21.0 direto (conta Profissional + URL HTTPS publica)
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# REELS_PUBLIC_BASE_URL=

# Caminho C: YouTube Data API v3 direto (rode: python scripts/youtube_auth.py)
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# YT_PRIVACY_STATUS=public

# --- 3) Voz IA Ultra-Realista (opcional; sem chave usa Edge-TTS masculino PT-BR gratis) ---
# ElevenLabs (voz humana cinematografica PT-BR):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# OpenAI TTS (gpt-4o-mini-tts / tts-1-hd, voz onyx ou ash):
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx
# GPT-SoVITS clonagem humana zero-shot (refs/GPT-SoVITS/api_v2.py no PC):
# GPT_SOVITS_API_URL=http://192.168.10.100:9880
# GPT_SOVITS_REF_AUDIO=refs/voz_referencia_br.wav
# GPT_SOVITS_PROMPT_TEXT=Texto exato falado no audio de referencia
# GPT_SOVITS_PROMPT_LANG=pt
# F5-TTS clonagem humana Flow Matching (scripts/start_f5_tts_server.py no PC):
# F5_TTS_API_URL=http://192.168.10.100:9881
# F5_TTS_REF_AUDIO=refs/voz_referencia_br.wav
# F5_TTS_REF_TEXT=Texto exato falado no audio de referencia
# Chatterbox local / self-hosted:
# CHATTERBOX_API_URL=

# --- 4) YouTube cookies (apenas se o YouTube pedir verificacao anti-bot) ---
# YTDLP_COOKIES=/data/data/com.termux/files/home/cookies.txt

